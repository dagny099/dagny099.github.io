---
layout: null
sitemap: false
---
{%- assign listens = site.listens | sort: "listened_on" | reverse -%}
{
  "generated": {{ site.time | date_to_xmlschema | jsonify }},
  "shows": {{ site.data.podcast_shows | jsonify }},
  "people": {{ site.data.podcast_people | jsonify }},
  "topics": {{ site.data.podcast_topics | jsonify }},
  "listens": [
  {%- for l in listens %}
    {
      "id": {{ l.url | jsonify }},
      "url": {{ l.url | relative_url | jsonify }},
      "title": {{ l.title | jsonify }},
      "show": {{ l.show | jsonify }},
      "episode_number": {{ l.episode_number | jsonify }},
      "published_on": {{ l.published_on | jsonify }},
      "listened_on": {{ l.listened_on | jsonify }},
      "listened_precision": {{ l.listened_precision | default: "day" | jsonify }},
      "guests": {{ l.guests | jsonify }},
      "topics": {{ l.topics | jsonify }},
      "duration_min": {{ l.duration_min | jsonify }},
      "episode_url": {{ l.episode_url | jsonify }},
      "summary": {{ l.summary | jsonify }},
      {%- comment %} Draft sparks (Claude-written) stay in the source files and never ship. {% endcomment %}
      "spark": {% if l.spark_draft %}null{% else %}{{ l.spark | jsonify }}{% endif %},
      "spark_draft": {{ l.spark_draft | default: false | jsonify }},
      "related_links": {{ l.related_links | jsonify }},
      "notes_html": {{ l.content | strip | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  ]
}
